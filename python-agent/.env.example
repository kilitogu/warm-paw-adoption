# 复制为 .env 后按本机情况修改；.env 已被 .gitignore 忽略，不会提交到仓库

# ===== 项目配置 =====
# 上传文件的保存目录（相对项目根目录）
FAST_PROFILE=./file

# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pet_agent
DB_USER=root
DB_PASSWORD=你的MySQL密码

# ===== 服务器配置 =====
SERVER_PORT=8080
# 前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Token 配置 =====
TOKEN_HEADER=Authorization
# 生产环境务必替换为随机 64 位字符串，可用 https://jwtsecretkeygenerator.com/zh/ 生成
TOKEN_SECRET=请替换为随机字符串
TOKEN_EXPIRE_HOURS=24
TOKEN_ALGORITHM=HS256

# ===== AI 助手配置 =====
# 兼容 OpenAI 协议的大模型服务；DeepSeek、通义千问、OpenAI 均可
LLM_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3

# 向量模型：openai（兼容 /embeddings 接口）/ huggingface（本地模型）
# 注意：DeepSeek 不提供 Embedding 接口，需要单独配置支持 Embedding 的服务
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# 向量库目录、召回条数、相似度阈值
VECTOR_STORE_DIR=./data/vectorstore
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35

# 会话空闲清理时间（分钟）
AI_SESSION_TTL_MINUTES=30
